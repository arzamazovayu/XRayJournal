<Window x:Class="XRayJournal.UI2.SearchPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XRayJournal.UI2"
        mc:Ignorable="d"
        Title="SearchPatientWindow" Height="299" Width="820" Background="#FF171717" ResizeMode="NoResize" SizeToContent="Height">
    <Window.Resources>
        <Style TargetType="Button" x:Key="Button">
            <Setter Property="Background" Value="#FF353535"/>
            <Setter Property="Foreground" Value="Silver"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="1,1,1,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="1,1,1,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Background" Value="#FF2D2D2D"/>
                    <Setter Property="Foreground" Value="Gray"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="true">
                    <Setter Property="Background" Value="#FF2D2D2D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" x:Key="TextBox">
            <Setter Property ="Background" Value="#FF353535" />
            <Setter Property ="Foreground" Value="#FFD4D4D4"/>
            <Setter Property ="VerticalContentAlignment" Value ="Stretch"/>
            <Setter Property ="HorizontalContentAlignment" Value ="Stretch"/>
            <Setter Property ="Margin" Value="0"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="IdEnterTextBox" TextWrapping="Wrap" Text="" 
                     Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"
                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
                     Style="{StaticResource ResourceKey=TextBox}" Margin="0,0,0,33" Grid.RowSpan="2"/>
            <Label Content="Введите id пациента" Foreground="#FFD4D4D4" 
                   Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                   VerticalContentAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,33" Grid.RowSpan="2"/>
            <TextBox x:Name="InfoTextBox" TextWrapping="Wrap" Text="Для изменения данных о пациенте проведите поиск и измените данные в соответствующих ячейках" 
                     IsReadOnly="True" Grid.ColumnSpan="6" Background="#FF171717"
                     Grid.Column="1" Grid.Row="3" HorizontalScrollBarVisibility="Auto" Padding="3,0,0,0"
                     Style="{StaticResource ResourceKey=TextBox}" Margin="0,0,0,32" Grid.RowSpan="2" BorderBrush="{x:Null}" />
            <TextBox x:Name="PatientIDTextBox" TextWrapping="Wrap" Text="" IsReadOnly="True" 
                     Grid.Column="1" Grid.Row="4" HorizontalScrollBarVisibility="Auto" Padding="3,0,0,0"
                     Style="{StaticResource ResourceKey=TextBox}" Margin="0,0,0,32" Grid.RowSpan="2" />
            <TextBox x:Name="PatientSecondNameTextBox" TextWrapping="Wrap" Text="" IsReadOnly="True" 
                     Grid.Column="2" Grid.Row="4" HorizontalScrollBarVisibility="Auto" Padding="3,0,0,0"
                     Style="{StaticResource ResourceKey=TextBox}" Margin="0,0,0,32" Grid.RowSpan="2" />
            <TextBox x:Name="PatientFirstNameTextBox" TextWrapping="Wrap" Text="" IsReadOnly="False" 
                     Grid.Column="3" Grid.Row="4" HorizontalScrollBarVisibility="Auto" Padding="3,0,0,0"
                     Style="{StaticResource ResourceKey=TextBox}" Margin="0,0,0,32" Grid.RowSpan="2" />
            <TextBox x:Name="PatientThirdNameTextBox" TextWrapping="Wrap" Text="" IsReadOnly="False" 
                     Grid.Column="4" Grid.Row="4" HorizontalScrollBarVisibility="Auto" Padding="3,0,0,0"
                     Style="{StaticResource ResourceKey=TextBox}" Margin="0,0,0,32" Grid.RowSpan="2" />
            <TextBox x:Name="PatientBirthDateTextBox" TextWrapping="Wrap" Text="" IsReadOnly="False" 
                     Grid.Column="5" Grid.Row="4" HorizontalScrollBarVisibility="Auto" Padding="3,0,0,0"
                     Style="{StaticResource ResourceKey=TextBox}" Margin="0,0,0,32" Grid.RowSpan="2" />
            <TextBox x:Name="PatientSexTextBox" TextWrapping="Wrap" Text="" IsReadOnly="False" 
                     Grid.Column="6" Grid.Row="4" HorizontalScrollBarVisibility="Auto" Padding="3,0,0,0"
                     Style="{StaticResource ResourceKey=TextBox}" Margin="0,0,0,32" Grid.RowSpan="2" />

            <Button x:Name="SearchButton" Content="Поиск" 
                    Grid.Column="1" Grid.Row="8" Click="SearchButton_Click" Grid.ColumnSpan="2"
                    Style="{StaticResource ResourceKey=Button}" Margin="1,1,1,1" />
            <Button x:Name="CloseButton" Content="Закрыть" 
                    Grid.Column="6" Grid.Row="8" Click="CloseButton_Click"
                    Style="{StaticResource ResourceKey=Button}" Margin="1,1,1,1"/>
            <Button x:Name="DeleteButton" Grid.Column="5" Content="Удалить пациента" Grid.Row="8"
                    Style="{StaticResource ResourceKey=Button}"  Margin="1,1,1,1" Click="DeleteButton_Click"/>
            <Button x:Name="ConfirmButton" Grid.Column="3" Content="Сохранить изменения" Grid.Row="8"
                    Style="{StaticResource ResourceKey=Button}"  Margin="1,1,1,1" Click="ConfirmButton_Click" />

        </Grid>
    </DockPanel>
</Window>
